{
  "name": "lse-campus-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node web/tools/prepare_release.mjs && node web/tools/check-assets.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "check": "node --check web/src/main.js && node --check web/src/viewer.js",
    "deploy": "npm run build && node web/tools/deploy_release.mjs",
    "gallery": "node web/tools/render_web_gallery.mjs",
    "prepare:mobile": "node web/tools/prepare-mobile-campus.mjs"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.58.2",
    "draco3dgltf": "1.5.9",
    "meshoptimizer": "1.3.0",
    "vite": "8.3.0",
    "wrangler": "4.136.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
