{
  "name": "lse-campus-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node web/tools/prepare_release.mjs && node web/tools/check-assets.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "check": "node --check web/src/main.js && node --check web/src/viewer.js",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "vite": "8.3.0",
    "wrangler": "4.136.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
